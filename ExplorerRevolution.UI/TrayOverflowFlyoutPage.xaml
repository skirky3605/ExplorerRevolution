<Page
    x:Class="ExplorerRevolution.UI.TrayOverflowFlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
        Win11 风格的托盘溢出 Flyout:圆角深色卡片 + 底部小箭头。
        整个页面运行在独立 XAML Island 线程上,因此颜色全部内联,
        不依赖 App.xaml 资源(避免跨线程资源解析问题)。
    -->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Border
            x:Name="FlyoutCard"
            Margin="0,0,0,8"
            Padding="8"
            Background="#F22B2B2B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel x:Name="RowsPanel" Orientation="Vertical" />
        </Border>
        <Polygon
            x:Name="FlyoutArrow"
            Width="20"
            Height="14"
            Margin="0,0,0,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Fill="#F22B2B2B"
            Stretch="Fill"
            Points="0,0 20,0 10,14" />
    </Grid>
</Page>
